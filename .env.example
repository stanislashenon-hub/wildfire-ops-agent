# LLM (any provider supported by langchain init_chat_model, e.g. "openai:gpt-5" after `pip install langchain-openai`)
MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=

# NASA FIRMS active fires - free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Langfuse tracing (optional) - free cloud account: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Replay a recorded scenario instead of live APIs (optional)
# WILDFIRE_SCENARIO=data/scenarios/oakland_hills_fire.json
